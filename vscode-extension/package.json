{
  "name": "cplus-language-support",
  "displayName": "C+ Language Support",
  "description": "Language support for C+ powered by the C+ Kotlin language server.",
  "version": "0.3.1",
  "publisher": "cplus",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "cplus",
    "c+",
    "language server"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:cplus",
    "onCommand:cplus.restartServer",
    "onCommand:cplus.showVersion"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cplus",
        "aliases": [
          "C+",
          "cplus"
        ],
        "extensions": [
          ".cp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cplus",
        "scopeName": "source.cplus",
        "path": "./syntaxes/cplus.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cplus.restartServer",
        "title": "C+: Restart Language Server"
      },
      {
        "command": "cplus.runMain",
        "title": "C+: Run Main"
      },
      {
        "command": "cplus.showVersion",
        "title": "C+: Show CLI Version"
      }
    ],
    "configuration": {
      "title": "C+",
      "properties": {
        "cplus.server.jarPath": {
          "type": "string",
          "default": "${workspaceFolder}/cli/build/libs/cplus-cli-0.1.0-SNAPSHOT-all.jar",
          "description": "Path to the self-contained C+ CLI JAR used to start the language server."
        },
        "cplus.server.sdkManifest": {
          "type": "string",
          "default": "",
          "description": "Optional SDK manifest path used by the CLI, useful when the project working directory is outside the CLI repository."
        },
        "cplus.server.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable used to launch the C+ CLI JAR."
        },
        "cplus.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the C+ CLI after `java -jar <jar>`."
        },
        "cplus.server.cwd": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "Working directory for the language server."
        },
        "cplus.run.mainSource": {
          "type": "string",
          "default": "${file}",
          "description": "C+ source file used as the entry point by C+: Run Main."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild extension.js --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "test": "npm run build && node --test test/extension.test.js",
    "test:host": "npm run package && node test/run-extension-host.js",
    "check": "node --check extension.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.0",
    "vscode-languageclient": "^9.0.1"
  }
}
