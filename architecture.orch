                "source": "fun deriveSemanticTokensAndNavigation(references, semanticModel2, toolingService2) {\n  val packet1 = pop(\"references\")\n  val packet2 = pop(\"semanticModel2\")\n  val outcome = toolingService2.invokeDeriveSemanticTokensAndNavigation(packet1, packet2)\n  when (outcome) {\n    is Success -> {\n    return outcome\n    }\n    is Failure -> {\n    return outcome\n    }\n  }\n}",
