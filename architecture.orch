                "source": "fun error_diagnosticsAndIncrementalWorkspace(sourceMap, compilation, toolingService3, sourceMap2) {\n  val packet1 = pop(\"sourceMap\")\n  val packet2 = pop(\"compilation\")\n  val packet3 = pop(\"sourceMap2\")\n  val outcome = toolingService3.invokeErrorDiagnosticsAndIncrementalWorkspace(packet1, packet2, packet3)\n  when (outcome) {\n    is Success -> {\n    push(\"diagnostics\", outcome.value)\n    push(\"workspaceState\", outcome.value)\n    push(\"workspaceState2\", outcome.value)\n    }\n    is Failure -> {\n    push(\"diagnostics\", outcome.error)\n    }\n  }\n}",
