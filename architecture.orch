        {
            "id": "node_a8e5a828-c507-4bbd-934f-fc17734e8721",
            "name": "SemanticModel",
            "kind": "Type",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [],
            "layout": {
                "x": 17028.0,
