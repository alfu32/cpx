                "source": "fun resolveTypes(typeUniverse2, semanticModel4, semanticResolutionService4) {\n  val packet1 = pop(\"typeUniverse2\")\n  val packet2 = pop(\"semanticModel4\")\n  val outcome = semanticResolutionService4.invokeResolveTypes(packet1, packet2)\n  when (outcome) {\n    is Success -> {\n    push(\"typedModel\", outcome.value)\n    push(\"typedModel2\", outcome.value)\n    }\n    is Failure -> {\n    return outcome\n    }\n  }\n}",
