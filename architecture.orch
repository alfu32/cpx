        {
            "id": "node_d1c7b0a8-567b-4ac4-9b9d-30bd2f810142",
            "name": "SourceAndOriginModel",
            "kind": "Type",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [],
            "layout": {
                "x": 16359.0,
