                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "",
                "sourceLanguageId": "kotlin",
                "specification": "# library_compileTimeEvaluation\n\n## Functional role\n\nThis library contains a free-standing function suite for compile Time Evaluation. It boxes reusable functions and algorithms used by processing functions.\n\n## Identifier convention\n\nThe library identifier MUST be prefixed with `lib_` or `library_`, or suffixed with `_lib` or `_library`. This library uses the required `library_` prefix: `library_compileTimeEvaluation`.\n\n## Technical contract\n\n- Exposes a `service` capability containing the free-standing function suite.\n- Its functions are free-standing and may encapsulate suite state and external I/O.\n- Owns the bulk algorithm, reusable policy, adapters, and coherent failure behavior for its suite.\n- Processing nodes receive this capability through a library argument link and invoke one operation per packet batch; they MUST NOT duplicate these algorithms.\n- Results use `Operation<T,E>` so expected errors can be routed as diagnostic packets.",
                "specificationLanguageId": "markdown",
                "tests": "{\"cases\":[]}",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "",
                "date": ""
            },
            "responsible": null,
            "modified": {
                "date": "2026-10-06T23:47:08.089679086Z",
                "user": "devlin"
            },
            "ports": [
                {
                    "id": "compileTimeEvaluationLibrary-service",
                    "name": "service",
                    "direction": "Output",
                    "dataType": "",
                    "metadata": {}
                }
            ],
            "link": null,
            "typeDefinition": null,
            "diagnostics": [],
