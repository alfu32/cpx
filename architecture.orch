        {
            "id": "node_013cc09e-f1d0-4c4a-982c-8fa4adc9d045",
            "name": "CDefinition",
            "kind": "Type",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [],
            "layout": {
                "x": 15185.0,
                "y": -1745.0,
                "width": 320.0,
                "height": 134.0,
                "closedWidth": 320.0,
