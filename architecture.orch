                "source": "fun stabilizeTypeUniverse(compileTimeEvaluationService5, structuralAst, expansionEvents2) {\n  val packet1 = pop(\"structuralAst\")\n  val packet2 = pop(\"expansionEvents2\")\n  val outcome = compileTimeEvaluationService5.invokeStabilizeTypeUniverse(packet1, packet2)\n  when (outcome) {\n    is Success -> {\n    push(\"typeUniverse\", outcome.value)\n    push(\"typeUniverse3\", outcome.value)\n    push(\"typeUniverse2\", outcome.value)\n    }\n    is Failure -> {\n    return outcome\n    }\n  }\n}",
