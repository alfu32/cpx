                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "",
                "sourceLanguageId": "kotlin",
                "specification": "# library_cBackend\n\n## Functional role\n\nThis library contains a method suite for c Backend. It boxes reusable functions and algorithms used by processing functions.\n\n## Identifier convention\n\nThe library identifier MUST be prefixed with `lib_` or `library_`, or suffixed with `_lib` or `_library`. This library uses the required `library_` prefix: `library_cBackend`.\n\n## Technical contract\n\n- Exposes a `service` capability containing the method suite.\n- Its methods are associated with the declared object-instance prototype `CSubsetAst`.\n- Owns the bulk algorithm, reusable policy, adapters, and coherent failure behavior for its suite.\n- Processing nodes receive this capability through a library argument link and invoke one operation per packet batch; they MUST NOT duplicate these algorithms.\n- Results use `Operation<T,E>` so expected errors can be routed as diagnostic packets.",
                "specificationLanguageId": "markdown",
                "tests": "{\"cases\":[]}",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "",
                "date": ""
            },
            "responsible": null,
            "modified": {
                "date": "2026-10-06T23:50:27.169740049Z",
                "user": "devlin"
            },
            "ports": [
                {
                    "id": "cBackendLibrary-service",
                    "name": "service",
                    "direction": "Output",
                    "dataType": "",
                    "metadata": {}
                }
            ],
            "link": null,
            "typeDefinition": null,
            "diagnostics": [],
            "metadata": {
