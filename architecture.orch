            "incomingLinks": [],
            "outgoingLinks": [
                "link_f97fc6d0-8494-43f0-90ad-7f10f71b001f",
                "link_ab233855-5ccc-4f40-9124-2e8479600405",
                "link_939e2774-d1e3-421f-bcf4-6add172ee17d",
                "link_e2875954-d84d-4ddd-bb35-398bec90d14f",
                "link_aeb1c16f-f68e-492d-9a4e-382612cc831f",
                "link_c4f54179-4cbd-4126-a169-51a27bf28860"
            ],
            "layout": {
                "x": 13876.0,
                "y": -365.0,
                "width": 242.0,
                "height": 210.0,
                "closedWidth": 242.0,
                "closedHeight": 210.0,
                "openWidth": 242.0,
                "openHeight": 210.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "",
                "sourceLanguageId": "kotlin",
                "specification": "# library_toolingServices\n\n## Functional role\n\nThis library contains a free-standing function suite for tooling Services. It boxes reusable functions and algorithms used by processing functions.\n\n## Identifier convention\n\nThe library identifier MUST be prefixed with `lib_` or `library_`, or suffixed with `_lib` or `_library`. This library uses the required `library_` prefix: `library_toolingServices`.\n\n## Technical contract\n\n- Exposes a `service` capability containing the free-standing function suite.\n- Its functions are free-standing and may encapsulate suite state and external I/O.\n- Owns the bulk algorithm, reusable policy, adapters, and coherent failure behavior for its suite.\n- Processing nodes receive this capability through a library argument link and invoke one operation per packet batch; they MUST NOT duplicate these algorithms.\n- Results use `Operation<T,E>` so expected errors can be routed as diagnostic packets.",
                "specificationLanguageId": "markdown",
                "tests": "{\"cases\":[]}",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "",
                "date": ""
            },
            "responsible": null,
            "modified": {
                "date": "2026-10-06T23:47:07.943680179Z",
                "user": "devlin"
            },
            "ports": [
                {
                    "id": "toolingServiceLibrary-service",
                    "name": "service",
                    "direction": "Output",
                    "dataType": "",
                    "metadata": {}
                }
            ],
            "link": null,
            "typeDefinition": null,
            "diagnostics": [],
            "metadata": {
                "sourceDocument": "SPEC.TECH.md",
                "architecturalStatus": "planned",
                "componentRole": "library",
                "architectureKey": "library_toolingServices",
                "librarySuiteKind": "freeStandingFunctions",
                "namingConvention": "library_",
                "identifierPattern": "^(lib_|library_).+|.+_(lib|library)$"
            },
            "pluginData": {},
            "nameDetail": "",
            "status": "BUSINESS",
